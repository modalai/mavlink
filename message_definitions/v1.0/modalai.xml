<?xml version="1.0"?>
<mavlink>
  <include>common.xml</include>
  <version>3</version>
  <dialect>200</dialect>
  <enums>
    <enum name="MAV_CMD">
      <entry value="610" name="MAV_CMD_DO_SET_SYS_CMP_ID" hasLocation="false" isDestination="false">
        <description>
          Set system and component id.
          This allows moving of a system and all its components to a new system id, or moving a particular component to a new system/component id.
          Recipients must reject command addressed to broadcast system ID.
        </description>
        <param index="1" label="System ID" minValue="1" maxValue="255" increment="1">New system ID for target component(s). 0: ignore and reject command (broadcast system ID not allowed).</param>
        <param index="2" label="Component ID" minValue="0" maxValue="255" increment="1">New component ID for target component(s). 0: ignore (component IDs don't change).</param>
        <param index="3" label="Reboot">Reboot components after ID change. Any non-zero value triggers the reboot.</param>
        <param index="4" reserved="true" default="NaN"/>
      </entry>

      <entry value="31133" name="MAV_CMD_VTX_SET_PROFILE" hasLocation="false" isDestination="false">
        <description>Set active VTX profile index.</description>
        <param index="1" label="Profile Index" minValue="0" increment="1">Profile index to apply.</param>
      </entry>
      <entry value="31134" name="MAV_CMD_VTX_SET_CHANNEL" hasLocation="false" isDestination="false">
        <description>Set active VTX channel index.</description>
        <param index="1" label="Channel Index" minValue="1" increment="1">Channel index to apply.</param>
      </entry>
      <entry value="31135" name="MAV_CMD_VTX_SET_POWER" hasLocation="false" isDestination="false">
        <description>Set active VTX transmit power table index.</description>
        <param index="1" label="Power Index" minValue="0" maxValue="63" increment="1">Power table index to apply.</param>
      </entry>

      <entry value="31136" name="MAV_CMD_MODALAI_PAYLOAD_CTRL" hasLocation="false" isDestination="false">
        <description>
          Arm/disarm and trigger/safe a payload component.
          Each param is independent; set to 0 to leave that axis unchanged.
        </description>
        <param index="1" label="Arm" minValue="0" maxValue="2" increment="1">Arm state. 0: no-change, 1: arm, 2: disarm.</param>
        <param index="2" label="Trigger" minValue="0" maxValue="2" increment="1">Trigger state. 0: no-change, 1: fire, 2: safe.</param>
      </entry>

      <entry value="31137" name="MAV_CMD_MODALAI_LED_CTRL" hasLocation="false" isDestination="false">
        <description>
          Set the active state of a Patrios light bar managed by voxl-io-server.
          Applies to all enabled patrios_light_bar behaviors.
        </description>
        <param index="1" label="State" minValue="0" maxValue="6" increment="1">Light state. 0: off, 1: white_low, 2: white_high, 3: white_strobe, 4: ir_low, 5: ir_high, 6: ir_strobe.</param>
      </entry>
    </enum>


    <enum name="MAV_ONBOARD_COMPUTER_STATUS_TYPE">
      <description>Type of onboard computer reported in ONBOARD_COMPUTER_STATUS.type.</description>
      <entry value="0" name="MAV_ONBOARD_COMPUTER_STATUS_PRIMARY">
        <description>Primary mission computer.</description>
      </entry>
      <entry value="1" name="MAV_ONBOARD_COMPUTER_STATUS_BACKUP_1">
        <description>Mission computer backup 1.</description>
      </entry>
      <entry value="2" name="MAV_ONBOARD_COMPUTER_STATUS_BACKUP_2">
        <description>Mission computer backup 2.</description>
      </entry>
      <entry value="3" name="MAV_ONBOARD_COMPUTER_STATUS_COMPUTE_NODE">
        <description>General compute node.</description>
      </entry>
      <entry value="4" name="MAV_ONBOARD_COMPUTER_STATUS_COMPUTE_SPARE_1">
        <description>Compute spare 1.</description>
      </entry>
      <entry value="5" name="MAV_ONBOARD_COMPUTER_STATUS_COMPUTE_SPARE_2">
        <description>Compute spare 2.</description>
      </entry>
      <entry value="6" name="MAV_ONBOARD_COMPUTER_STATUS_PAYLOAD_1">
        <description>Payload computer 1.</description>
      </entry>
      <entry value="7" name="MAV_ONBOARD_COMPUTER_STATUS_PAYLOAD_2">
        <description>Payload computer 2.</description>
      </entry>
      <entry value="8" name="MAV_ONBOARD_COMPUTER_STATUS_PAYLOAD_3">
        <description>Payload computer 3.</description>
      </entry>
      <entry value="9" name="MAV_ONBOARD_COMPUTER_STATUS_PAYLOAD_4">
        <description>Payload computer 4.</description>
      </entry>
    </enum>
  </enums>

  <messages>
    <message id="52610" name="VTX_STATUS">
      <description>Current VTX operating status and custom configuration flags.</description>
      <field type="uint8_t" name="profile">Active VTX profile index.</field>
      <field type="uint16_t" name="channel">Active VTX channel index.</field>
      <field type="uint8_t" name="power">Active VTX power table index.</field>
      <field type="uint8_t" name="modem_conf">Bitfield indicating modem configuration. 0x01: VTX, 0x02: VRX, others reserved.</field>
      <field type="uint32_t" name="custom_status">Extra status fields, hardware specific.</field>
    </message>
  </messages>
</mavlink>
